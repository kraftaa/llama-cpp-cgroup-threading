From d9ae21d39ad086270c399dbe7d386cb6be87b228 Mon Sep 17 00:00:00 2001
From: Maria Dubyaga <8140777+kraftaa@users.noreply.github.com>
Date: Tue, 13 Oct 2026 20:34:00 -0400
Subject: [PATCH follow-up] common: round fractional cgroup quotas up

---
 common/common.cpp | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/common/common.cpp b/common/common.cpp
index 9da271f44..735a8e67d 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -200,6 +200,17 @@ static int cpu_count_math_cpus(int n_cpu) {
 #endif // __x86_64__ && __linux__
 
 #if defined(__linux__) && !defined(__ANDROID__)
+static int32_t common_cpu_quota_to_threads(int64_t quota_us, int64_t period_us) {
+    if (quota_us <= 0 || period_us <= 0) {
+        return 0;
+    }
+
+    // A fractional CPU quota can execute on the next CPU for part of each
+    // period. Rounding down would leave that part of the quota unused.
+    const int64_t threads = quota_us / period_us + (quota_us % period_us != 0);
+    return static_cast<int32_t>(std::min<int64_t>(threads, INT32_MAX));
+}
+
 // Return the number of CPUs allowed by the current cgroup, or zero when no
 // quota is configured or the cgroup files are unavailable.
 static int32_t common_cpu_get_cgroup_limit() {
@@ -212,11 +223,10 @@ static int32_t common_cpu_get_cgroup_limit() {
         }
         int64_t quota_us = 0;
         std::istringstream quota_stream(quota);
-        if (!(quota_stream >> quota_us) ||
-                quota_us <= 0 || period_us <= 0) {
+        if (!(quota_stream >> quota_us)) {
             return 0;
         }
-        return static_cast<int32_t>(std::max<int64_t>(1, quota_us / period_us));
+        return common_cpu_quota_to_threads(quota_us, period_us);
     };
 
     // cgroup v2: a single line containing "quota period" or "max period".
@@ -230,10 +240,10 @@ static int32_t common_cpu_get_cgroup_limit() {
     int64_t quota_us = 0;
     int64_t period_us = 0;
     if (!quota_file || !period_file || !(quota_file >> quota_us) ||
-            !(period_file >> period_us) || quota_us <= 0 || period_us <= 0) {
+            !(period_file >> period_us)) {
         return 0;
     }
-    return static_cast<int32_t>(std::max<int64_t>(1, quota_us / period_us));
+    return common_cpu_quota_to_threads(quota_us, period_us);
 }
 #endif
 
